# PostgreSQL/PostGIS settings for the optional Brazilian CNEFE geocoder example
POSTGRES_DB=address_db
POSTGRES_USER=postgres
# Required: Set a strong, random password before starting containers
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432
# Storage directory for database files.
# The default is relative to this example directory.
# Change this to an external path if you want to store heavy geocoding data on an external disk.
POSTGRES_DATA_DIR=./.pgdata

# Download directory for raw Brazilian CNEFE archives from IBGE
CNEFE_DOWNLOAD_DIR=./downloads_cnefe
POSTGRES_CONTAINER=address_standardizer_brazilian_cnefe
